        },
        {
          "assertion_id": "azuregoat_dev_container_public",
          "member_ref": "main.tf",
          "expected_fragments": [
            "resource \"azurerm_storage_container\" \"storage_container_dev\"",
            "container_access_type = \"container\""
          ],
          "literal_interpretation": "The development container grants anonymous container and blob access."
        }
      ],
      "upstream_claim_refs": [
        "attack-manuals/module-1/04-Security Misconfiguration.md"
      ],
      "entry": "anonymous internet client",
      "mandatory_claims": [
        "production container anonymous list is denied",
        "development container anonymous list succeeds",
        "development container anonymous blob read succeeds"
      ],
      "data_target": {
        "type": "object_storage",
        "service": "Azure Blob Storage",
        "operation_scope": [
          "List container",
          "Read blob"
        ]
      },
      "upstream_expected_outcome": "paired negative production state and positive development state",
      "validation_plan": [
        "freeze both container access configurations from the same deployment",
        "issue identical unauthenticated list probes to production and development containers",
        "retain the explicit production denial, development success, and storage logs as a paired certificate"
