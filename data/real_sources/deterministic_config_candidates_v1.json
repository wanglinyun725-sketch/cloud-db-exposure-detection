          "member_ref": "modules/module-2/main.tf",
          "expected_fragments": [
            "resource \"aws_iam_role\" \"ecs-task-role\"",
            "resource \"aws_iam_role_policy_attachment\" \"ecs-task-role-attachment-2\"",
            "policy_arn = \"arn:aws:iam::aws:policy/SecretsManagerReadWrite\"",
            "task_role_arn            = aws_iam_role.ecs-task-role.arn"
          ],
          "literal_interpretation": "The ECS task uses ecs-task-role and that role is attached to AWS SecretsManagerReadWrite."
        }
      ],
      "upstream_claim_refs": [
        "attack-manuals/module-2/02-File Upload and Task Metadata.md"
      ],
      "entry": "low-privilege application workflow with an unrestricted manager-side file upload",
      "mandatory_claims": [
        "uploaded server-side code reaches the ECS task environment",
        "the task credential endpoint releases the ECS task-role credentials",
        "the task role can list secrets and retrieve RDS_CREDS"
      ],
      "data_target": {
        "type": "secret_store",
        "service": "AWS Secrets Manager",
        "operation_scope": [
          "ListSecrets",
          "GetSecretValue"
        ],
        "downstream_asset": "Amazon RDS credentials"
      },
      "upstream_expected_outcome": "reachable_to_secret; RDS query remains unproven",
      "validation_plan": [
        "separate Secrets Manager credential exposure from unproven database access",
        "analyze the task role against the exact secret ARN",
        "probe GetSecretValue and retain CloudTrail; do not claim an RDS data read without a database query record"
      ],
      "evidence_status": "terraform_semantics_valid_awaiting_native_analysis_and_runtime_probe",
      "gold_label": null,
      "label_origin": null
    },
