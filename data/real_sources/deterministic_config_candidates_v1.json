          "storage.buckets.setIamPolicy",
          "storage.objects.list"
        ]
      },
      "upstream_expected_outcome": "negative-to-positive state transition",
      "validation_plan": [
        "save pre-mutation and post-mutation IAM policies as distinct frozen states",
        "run Policy Analyzer and testIamPermissions for the exact allUsers principal and bucket",
