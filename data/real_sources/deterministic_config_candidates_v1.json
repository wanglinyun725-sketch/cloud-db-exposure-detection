            "resource \"google_project_iam_custom_role\" \"prod-role\"",
            "permissions = [\"storage.objects.get\"]",
            "resource \"google_storage_bucket_iam_member\" \"add_policy_role\"",
            "member = \"allUsers\""
          ],
          "literal_interpretation": "The production bucket custom role gives allUsers object read when an object name is known, but not object listing."
        },
        {
          "assertion_id": "gcpgoat_dev_allusers_policy_mutation",
          "member_ref": "main.tf",
          "expected_fragments": [
            "resource \"google_project_iam_custom_role\" \"dev-role\"",
            "permissions = [\"storage.objects.get\", \"storage.buckets.setIamPolicy\", \"storage.buckets.getIamPolicy\"]",
            "resource \"google_storage_bucket_iam_member\" \"add_policy_role2\"",
            "member = \"allUsers\""
          ],
          "literal_interpretation": "The development bucket gives allUsers object read plus bucket IAM read/write, but not initial object listing."
        }
      ],
      "upstream_claim_refs": [
        "attack-manuals/module-1/02-Misconfigured Storage Bucket Policies.md"
      ],
      "entry": "anonymous allUsers principal",
      "mandatory_claims": [
        "initial production and development object-list operations are denied",
        "development allUsers can read and set the bucket IAM policy",
        "after the policy mutation, anonymous object listing succeeds"
      ],
      "data_target": {
        "type": "object_storage",
