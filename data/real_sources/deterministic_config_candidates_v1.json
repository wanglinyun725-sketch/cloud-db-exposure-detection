      "case_id": "awsgoat_m1_ssrf_dynamodb",
      "source_id": "awsgoat",
      "platform": "AWS",
      "revision": "b24869ad455ed8d1393d00ecdc15ee638d1c1332",
      "configuration_refs": [
        "modules/module-1/main.tf"
      ],
      "configuration_assertions": [
        {
          "assertion_id": "awsgoat_m1_public_api_method",
          "member_ref": "modules/module-1/main.tf",
          "expected_fragments": [
            "resource \"aws_api_gateway_method\" \"endpoint\"",
            "authorization = \"NONE\""
          ],
          "literal_interpretation": "The API Gateway method is configured without API Gateway authorization."
        },
        {
          "assertion_id": "awsgoat_m1_lambda_dynamodb_wildcard",
          "member_ref": "modules/module-1/main.tf",
          "expected_fragments": [
            "resource \"aws_iam_role_policy_attachment\" \"blog_app_policy\"",
            "policy_arn = aws_iam_policy.lambda_data_policies.arn",
            "\"dynamodb:*\"",
            "\"Effect\" : \"Allow\"",
            "\"Resource\" : \"*\""
          ],
          "literal_interpretation": "The Lambda data role is attached to a policy containing an allow for all DynamoDB actions on all resources."
        },
        {
          "assertion_id": "awsgoat_m1_blog_users_table",
          "member_ref": "modules/module-1/main.tf",
          "expected_fragments": [
            "resource \"aws_dynamodb_table\" \"users_table\"",
            "name           = \"blog-users\""
          ],
          "literal_interpretation": "The frozen module declares the blog-users DynamoDB table."
        }
      ],
      "upstream_claim_refs": [
        "attack-manuals/module-1/06-Server Side Request Forgery Part 2.md"
      ],
      "entry": "registered web-application user invoking a file/URL fetch function",
      "mandatory_claims": [
        "web input can read the Lambda execution environment",
        "recovered Lambda credentials can enumerate and scan blog-users",
        "the same credentials can write an item to blog-users"
      ],
      "data_target": {
        "type": "database",
        "service": "Amazon DynamoDB",
        "operation_scope": [
          "ListTables",
          "Scan",
          "PutItem"
        ]
      },
      "upstream_expected_outcome": "reachable",
      "validation_plan": [
        "resolve the exact Lambda role, DynamoDB table ARN, actions, boundaries, and resource policies from deployed state",
        "run complete-scope AWS policy analysis for ListTables, Scan, and PutItem",
        "in an isolated account, probe the three operations and retain CloudTrail records"
      ],
      "evidence_status": "terraform_semantics_valid_awaiting_native_analysis_and_runtime_probe",
      "gold_label": null,
      "label_origin": null
    },
