{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.cloud-db-pathbench/negative-control-annotation.schema.json",
  "title": "Human-screened real cloud incident negative control",
  "type": "object",
  "required": [
    "candidate_id",
    "independence_group",
    "independence_group_basis",
    "source",
    "vendor",
    "data_relevance_facets",
    "security_term_hits",
    "report_text",
    "raw_ref",
    "screening"
  ],
  "properties": {
    "candidate_id": {"type": "string", "minLength": 1},
    "independence_group": {"type": "string", "minLength": 1},
    "independence_group_basis": {
      "enum": [
        "upstream_incident_url",
        "upstream_tracking_id",
        "source_record_sha256"
      ]
    },
    "source": {
      "type": "object",
      "required": ["source_id", "doi", "version", "license"],
      "properties": {
        "source_id": {"const": "cloud_incident_reports_2016_2024"},
        "doi": {"const": "10.5281/zenodo.14010282"},
        "version": {"type": "string", "minLength": 1},
        "license": {"const": "CC-BY-4.0"}
      }
    },
    "vendor": {"enum": ["AWS", "AZURE", "GCP"]},
    "service_hint": {"type": ["string", "null"]},
    "year": {"type": ["string", "null"]},
    "data_relevance_facets": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "security_term_hits": {
      "type": "array",
      "items": {"type": "string"}
    },
    "report_text": {"type": "string", "minLength": 1},
    "raw_ref": {
      "type": "object",
      "required": [
        "archive_relative_path",
        "archive_sha256",
        "member_path",
        "record_index",
        "record_sha256"
      ],
      "properties": {
        "archive_relative_path": {"type": "string"},
        "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "member_path": {"type": "string"},
        "record_index": {"type": "integer", "minimum": 0},
        "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "screening": {
      "type": "object",
      "required": [
        "status",
        "label_origin",
        "cloud_data_relevant",
        "non_attack_confirmed",
        "usable_as_negative_control",
        "primary_annotator",
        "reviewer",
        "rationale"
      ],
      "properties": {
        "status": {
          "enum": ["pending", "primary_complete", "reviewed", "adjudicated", "rejected"]
        },
        "label_origin": {
          "enum": [null, "human_primary", "human_reviewed", "human_adjudicated"]
        },
        "cloud_data_relevant": {"type": ["boolean", "null"]},
        "non_attack_confirmed": {"type": ["boolean", "null"]},
        "usable_as_negative_control": {"type": ["boolean", "null"]},
        "primary_annotator": {"type": ["string", "null"]},
        "reviewer": {"type": ["string", "null"]},
        "rationale": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "pending"}}},
          "then": {
            "properties": {
              "label_origin": {"const": null},
              "cloud_data_relevant": {"const": null},
              "non_attack_confirmed": {"const": null},
              "usable_as_negative_control": {"const": null},
              "primary_annotator": {"const": null},
              "reviewer": {"const": null},
              "rationale": {"const": null}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "primary_complete"}}},
          "then": {"properties": {"label_origin": {"const": "human_primary"}}}
        },
        {
          "if": {"properties": {"status": {"const": "reviewed"}}},
          "then": {"properties": {"label_origin": {"const": "human_reviewed"}}}
        },
        {
          "if": {"properties": {"status": {"const": "adjudicated"}}},
          "then": {"properties": {"label_origin": {"const": "human_adjudicated"}}}
        }
      ]
    }
  }
}
