{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.cloud-db-pathbench/realpathbench-v2.schema.json",
  "title": "RealPathBench-CD v2 human-annotated case",
  "type": "object",
  "required": [
    "case_id",
    "source",
    "annotation",
    "nodes",
    "edges",
    "path_labels",
    "tool_tasks"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "source_id",
        "upstream_url",
        "version_or_commit",
        "license",
        "provenance_level",
        "raw_artifacts"
      ],
      "properties": {
        "source_id": {
          "type": "string"
        },
        "upstream_url": {
          "type": "string",
          "format": "uri"
        },
        "version_or_commit": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "provenance_level": {
          "enum": ["A", "B", "C"]
        },
        "raw_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["raw_ref", "sha256"],
            "properties": {
              "raw_ref": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "annotation": {
      "type": "object",
      "required": [
        "status",
        "label_origin",
        "primary_annotator",
        "reviewer",
        "adjudication"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "primary_complete",
            "reviewed",
            "adjudicated",
            "needs_execution",
            "rejected"
          ]
        },
        "label_origin": {
          "enum": [
            null,
            "human_primary",
            "human_reviewed",
            "human_adjudicated"
          ]
        },
        "primary_annotator": {
          "type": ["string", "null"]
        },
        "reviewer": {
          "type": ["string", "null"]
        },
        "adjudication": {
          "type": ["string", "null"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {"const": "pending"}
            }
          },
          "then": {
            "properties": {
              "label_origin": {"const": null}
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {"const": "primary_complete"}
            }
          },
          "then": {
            "properties": {
              "label_origin": {"const": "human_primary"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {"const": "reviewed"}
            }
          },
          "then": {
            "properties": {
              "label_origin": {"const": "human_reviewed"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {"const": "adjudicated"}
            }
          },
          "then": {
            "properties": {
              "label_origin": {"const": "human_adjudicated"}
            }
          }
        }
      ]
    },
    "path_ontology": {
      "type": "object",
      "required": ["ontology_id", "version", "sha256"],
      "properties": {
        "ontology_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "raw_refs"],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "raw_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "edge_id",
          "source",
          "target",
          "type",
          "evidence_state",
          "evidence_items",
          "raw_refs",
          "annotator_rationale"
        ],
        "properties": {
          "edge_id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "evidence_state": {
            "enum": ["Supported", "Contradicted", "Unknown", "Conflict"]
          },
          "evidence_items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "evidence_id",
                "polarity",
                "raw_ref",
                "query_cost",
                "source"
              ],
              "properties": {
                "evidence_id": {
                  "type": "string",
                  "minLength": 1
                },
                "polarity": {
                  "enum": ["support", "refute"]
                },
                "raw_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "query_cost": {
                  "type": "number",
                  "minimum": 0
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "raw_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "annotator_rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "evidence_state": {"const": "Supported"}
              }
            },
            "then": {
              "properties": {
                "evidence_items": {
                  "contains": {
                    "properties": {"polarity": {"const": "support"}},
                    "required": ["polarity"]
                  },
                  "not": {
                    "contains": {
                      "properties": {"polarity": {"const": "refute"}},
                      "required": ["polarity"]
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "evidence_state": {"const": "Contradicted"}
              }
            },
            "then": {
              "properties": {
                "evidence_items": {
                  "contains": {
                    "properties": {"polarity": {"const": "refute"}},
                    "required": ["polarity"]
                  },
                  "not": {
                    "contains": {
                      "properties": {"polarity": {"const": "support"}},
                      "required": ["polarity"]
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "evidence_state": {"const": "Unknown"}
              }
            },
            "then": {
              "properties": {
                "evidence_items": {"maxItems": 0}
              }
            }
          },
          {
            "if": {
              "properties": {
                "evidence_state": {"const": "Conflict"}
              }
            },
            "then": {
              "properties": {
                "evidence_items": {
                  "allOf": [
                    {
                      "contains": {
                        "properties": {"polarity": {"const": "support"}},
                        "required": ["polarity"]
                      }
                    },
                    {
                      "contains": {
                        "properties": {"polarity": {"const": "refute"}},
                        "required": ["polarity"]
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "path_labels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path_id",
          "node_ids",
          "edge_ids",
          "state",
          "certificate_raw_refs"
        ],
        "properties": {
          "path_id": {
            "type": "string"
          },
          "node_ids": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "edge_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "state": {
            "enum": ["Valid", "Invalid", "Insufficient", "Conflict"]
          },
          "certificate_raw_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "tool_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tool_name",
          "query_scope",
          "observable_raw_refs",
          "query_cost"
        ],
        "properties": {
          "tool_name": {
            "type": "string"
          },
          "query_scope": {
            "type": "object"
          },
          "observable_raw_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "query_cost": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "instance_labels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "instance_id",
          "overall_state",
          "path_states",
          "evidence_raw_refs",
          "annotator_rationale"
        ],
        "properties": {
          "instance_id": {
            "type": "string",
            "minLength": 1
          },
          "overall_state": {
            "enum": ["Valid", "Invalid", "Insufficient", "Conflict"]
          },
          "path_states": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path_id", "state"],
              "properties": {
                "path_id": {
                  "type": "string",
                  "minLength": 1
                },
                "state": {
                  "enum": ["Valid", "Invalid", "Insufficient", "Conflict"]
                }
              }
            }
          },
          "evidence_raw_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "annotator_rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
